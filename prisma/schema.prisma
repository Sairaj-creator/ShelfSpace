generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  pro
}

enum Role {
  owner
  admin
  staff
}

enum OrderStatus {
  pending
  fulfilled
  cancelled
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  stripe_customer_id  String?
  subscription_status String?
  plan                Plan     @default(free)
  created_at          DateTime @default(now())

  users    User[]
  products Product[]
  orders   Order[]
  locations Location[]
  audit_logs AuditLog[]
  idempotency_records IdempotencyRecord[]

  @@map("organizations")
}

model IdempotencyRecord {
  key        String
  org_id     String
  response   Json
  created_at DateTime @default(now())
  expires_at DateTime

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  @@id([org_id, key])
  @@index([org_id])
  @@map("idempotency_records")
}

model User {
  id            String   @id @default(uuid())
  org_id        String
  email         String   @unique
  email_verified Boolean  @default(false)
  password_hash String
  role          Role
  created_at    DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([org_id])
  @@map("users")
}

model Product {
  id                  String   @id @default(uuid())
  org_id              String
  name                String
  sku                 String
  price               Int // Stored in cents
  search_vector       Unsupported("tsvector")?
  created_at          DateTime @default(now())
  deleted_at          DateTime?

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  order_items  OrderItem[]
  inventory_levels InventoryLevel[]

  @@index([org_id])
  @@map("products")
}

model Order {
  id            String      @id @default(uuid())
  org_id        String
  customer_name String
  status        OrderStatus @default(pending)
  total         Int // Store as cents
  created_at    DateTime    @default(now())
  deleted_at    DateTime?

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([org_id])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid())
  order_id   String
  product_id String
  location_id String
  qty        Int
  unit_price Int // Store as cents at time of order

  order    Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  location Location @relation(fields: [location_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  org_id      String
  actor_id    String
  action      String   // USER_INVITED, USER_REMOVED, ORDER_CANCELLED, STOCK_UPDATED, BULK_PRODUCTS_IMPORTED
  target_id   String?
  details     String?  // JSON context
  created_at  DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  @@index([org_id])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  user_id    String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model Location {
  id         String   @id @default(uuid())
  org_id     String
  name       String
  address    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization     Organization     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  inventory_levels InventoryLevel[]
  order_items      OrderItem[]

  @@index([org_id])
  @@map("locations")
}

model InventoryLevel {
  id                  String   @id @default(uuid())
  product_id          String
  location_id         String
  stock_qty           Int      @default(0)
  low_stock_threshold Int      @default(0)
  updated_at          DateTime @updatedAt

  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([product_id, location_id])
  @@index([product_id])
  @@index([location_id])
  @@map("inventory_levels")
}
